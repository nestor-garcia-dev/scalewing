{
  "name": "@scalewing/react",
  "version": "1.52.0",
  "description": "Scalewing DOM components and package-owned CSS utilities.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestor-garcia-dev/scalewing.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/nestor-garcia-dev/scalewing#readme",
  "bugs": {
    "url": "https://github.com/nestor-garcia-dev/scalewing/issues"
  },
  "sideEffects": [
    "*.css",
    "./*/document-viewer-worker.*"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./document-viewer-worker": {
      "types": "./src/document-viewer-worker.ts",
      "import": "./src/document-viewer-worker.ts"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./palette/*.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/palette/*.css"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "styles.css.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node --import ./scripts/register-tokens-dist.mjs scripts/write-css.js",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@scalewing/tokens": "workspace:^",
    "markdown-it": "14.3.2",
    "pdfjs-dist": "6.4.299"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/markdown-it": "14.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./document-viewer-worker": {
        "types": "./dist/document-viewer-worker.d.ts",
        "import": "./dist/document-viewer-worker.js"
      },
      "./styles.css": {
        "types": "./styles.css.d.ts",
        "default": "./dist/styles.css"
      },
      "./palette/*.css": {
        "types": "./styles.css.d.ts",
        "default": "./dist/palette/*.css"
      }
    }
  }
}
