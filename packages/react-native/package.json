{
  "name": "@scalewing/react-native",
  "version": "0.3.0",
  "description": "Scalewing React Native layout primitives.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/dna-consulting/scalewing.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://gitlab.com/dna-consulting/scalewing#readme",
  "bugs": {
    "url": "https://gitlab.com/dna-consulting/scalewing/-/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@scalewing/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "react-native": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
