{
  "name": "scalewing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "preinstall": "only-allow pnpm",
    "build": "pnpm --workspace-concurrency=1 -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm typecheck",
    "changeset": "changeset",
    "dev:web": "pnpm --filter @scalewing/tokens build && pnpm --filter @scalewing/react build && pnpm --filter @scalewing/gallery dev",
    "watch:tokens-css": "node scripts/watch-tokens-css.mjs",
    "build:gallery": "pnpm --filter @scalewing/tokens build && pnpm --filter @scalewing/react build && pnpm --filter @scalewing/gallery build",
    "preview:gallery": "pnpm --filter @scalewing/gallery preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --workspace-concurrency=1 -r --if-present test",
    "typecheck": "pnpm --workspace-concurrency=1 -r --if-present typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.5.2",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "only-allow": "^1.2.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
